#!/usr/bin/env bash
set -euo pipefail

repository_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python_executable="${SYNTH_PYTHON:-${repository_dir}/.venv/bin/python}"

if [[ ! -x "${python_executable}" ]]; then
  echo "Python environment not found. Run the README setup first." >&2
  exit 1
fi

cd "${repository_dir}"
exec "${python_executable}" -m tuva_synthetic "$@"
